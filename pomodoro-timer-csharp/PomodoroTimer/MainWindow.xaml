<Window x:Class="PomodoroTimer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PomodoroTimer"
        mc:Ignorable="d"
        Title="Pomodoro" Height="720" Width="480"
        ResizeMode="CanMinimize"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <StackPanel Width="420" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,16">

            <TextBlock Text="Pomodoro" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                       HorizontalAlignment="Center" Margin="0,0,0,20" />

            <Border Background="{StaticResource PanelBrush}" CornerRadius="26" Height="52" Padding="6" Margin="0,0,0,28">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="ModeFocusBtn" Content="Foco" Width="130" Style="{StaticResource PillButtonStyle}" Click="ModeButton_Click" Tag="focus" />
                    <Button x:Name="ModeShortBtn" Content="Pausa curta" Width="130" Style="{StaticResource PillButtonStyle}" Click="ModeButton_Click" Tag="short" />
                    <Button x:Name="ModeLongBtn" Content="Pausa longa" Width="130" Style="{StaticResource PillButtonStyle}" Click="ModeButton_Click" Tag="long" />
                </StackPanel>
            </Border>

            <Grid Width="220" Height="220" Margin="0,0,0,28" HorizontalAlignment="Center">
                <Canvas Width="220" Height="220">
                    <Ellipse Width="200" Height="200" Canvas.Left="10" Canvas.Top="10"
                             Stroke="{StaticResource RingBgBrush}" StrokeThickness="12" />
                    <Path x:Name="RingProgressPath" Stroke="{StaticResource FocusBrush}" StrokeThickness="12"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </Canvas>
                <TextBlock x:Name="TimeDisplay" Text="25:00" FontSize="42" FontWeight="Light"
                           Foreground="{StaticResource TextBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,32">
                <Button x:Name="StartPauseBtn" Content="Iniciar" Style="{StaticResource PrimaryButtonStyle}" Width="140" Click="StartPauseBtn_Click" Margin="0,0,12,0" />
                <Button x:Name="ResetBtn" Content="Reiniciar" Style="{StaticResource ControlButtonStyle}" Click="ResetBtn_Click" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,32">
                <StackPanel Margin="0,0,40,0" HorizontalAlignment="Center">
                    <TextBlock x:Name="SessionCountText" Text="0" FontSize="26" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="sessões hoje" FontSize="12" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock x:Name="MinutesFocusedText" Text="0" FontSize="26" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="minutos focados" FontSize="12" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                </StackPanel>
            </StackPanel>

            <Border Background="{StaticResource PanelBrush}" CornerRadius="16" Padding="20,16" MaxHeight="220">
                <StackPanel>
                    <TextBlock Text="Histórico" FontSize="14" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,10" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="170">
                        <ItemsControl x:Name="HistoryItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding TypeLabel}" Foreground="{StaticResource MutedBrush}" FontSize="13" />
                                        <TextBlock Grid.Column="1" Text="{Binding SummaryText}" Foreground="{StaticResource TextBrush}" FontSize="13" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>

        </StackPanel>
    </Grid>
</Window>
